# ==========================================
# AURUM ALERT - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# GOLDAPI.IO CONFIGURATION
# Provider: GoldAPI.io (Free Plan: 150 reqs/month)
# Documentation: https://www.goldapi.io/
# Sign up and paste your free x-access-token key below:
# ------------------------------------------
GOLDAPI_API_KEY=goldapi-your-key-here

# ------------------------------------------
# TELEGRAM BOT API CONFIGURATION
# 1. Create a bot using @BotFather on Telegram to get your token
# 2. Get your Chat ID by messaging your bot and checking:
#    https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# ------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-personal-telegram-chat-id

# ------------------------------------------
# WEBHOOK DISPATCH SECURITY (Optional)
# Secret key to protect manual /api/notifications/dispatch webhooks
# ------------------------------------------
CRON_SECRET=your-random-cron-secret-token

# ------------------------------------------
# SUPABASE CONFIGURATION (Optional - Future Storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
