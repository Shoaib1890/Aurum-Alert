# ==========================================
# AURUM ALERT - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# GOLDAPI.IO CONFIGURATION (Phase 2A)
# Provider: GoldAPI.io (Free Plan: 150 reqs/month)
# Documentation: https://www.goldapi.io/
# Sign up and paste your free x-access-token key below:
# ------------------------------------------
GOLDAPI_API_KEY=goldapi-your-key-here

# ------------------------------------------
# META WHATSAPP CLOUD API (Phase 3)
# Meta Developer Portal: https://developers.facebook.com/
# WhatsApp > API Setup:
# ------------------------------------------
# 1. System user permanent access token (or sandbox temporary token)
WHATSAPP_API_TOKEN=your-meta-whatsapp-access-token

# 2. Sender Phone Number ID from Meta Developer Console (e.g., "105934827182910")
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# 3. WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# 4. Your personal WhatsApp recipient number with country code (e.g. 919876543210, no + or spaces)
WHATSAPP_RECIPIENT_PHONE=9198XXXXXXXX

# 5. Secret key to protect manual /api/notifications/dispatch webhooks
CRON_SECRET=your-random-cron-secret-token

# ------------------------------------------
# SUPABASE CONFIGURATION (Optional - Future Storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
